# Copy these into your hosting dashboard (Render > Environment). Never commit real values.

# Provider keys (get them at https://aistudio.google.com/ and https://console.groq.com/keys)
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# Optional: models can be changed here without touching code
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-20b

# Optional: shared secret the app sends in the x-app-token header
APP_TOKEN=

# Optional tuning
PORT=3000
AI_TIMEOUT_MS=20000
RATE_LIMIT_PER_MIN=30
ALLOWED_ORIGINS=

